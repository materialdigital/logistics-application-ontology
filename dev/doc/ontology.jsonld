    "@id" : "http://purl.obolibrary.org/obo/BFO_0000051"
  } ]
}, {
  "@id" : "http://purl.obolibrary.org/obo/IAO_0000104",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "A directive information entity with action specifications and objective specifications as parts, and that may be concretized as a realizable entity that, if realized, is realized in a process in which the bearer tries to achieve the objectives by taking the actions specified."
  } ],
  "http://purl.obolibrary.org/obo/IAO_0000119" : [ {
    "@language" : "en",
    "@value" : "OBI Plan and Planned Process branch"
  }, {
    "@language" : "en",
    "@value" : "OBI_0000344"
  } ],
